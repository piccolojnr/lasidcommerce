BACKTHRED_IMAGE_PREFIX=ghcr.io/piccolojnr/backthred
BACKTHRED_IMAGE_TAG=latest
BACKTHRED_COMPOSE_ENV_FILE=.env
BACKTHRED_STORAGE_LINK=true
BACKTHRED_RUN_MIGRATIONS=false

APP_NAME="Backthred"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_PORT=8080
NGINX_SERVER_NAME=example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=backthred
DB_USERNAME=backthred
DB_PASSWORD=change-me

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

STOREFRONT_URL=https://storefront.example.com
STOREFRONT_SESSION_COOKIE=storefront_session
STOREFRONT_SESSION_DOMAIN=null
STOREFRONT_CSRF_COOKIE=XSRF-STOREFRONT-TOKEN
STOREFRONT_CSRF_HEADER=X-STOREFRONT-CSRF-TOKEN
STOREFRONT_DEFAULT_REDIRECT_PATH=/account
STOREFRONT_ORDERS_PATH=/account/orders
STOREFRONT_AUTH_ERROR_REDIRECT_PATH=/auth/login
STOREFRONT_MAGIC_LINK_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=true
CATALOG_NEW_ARRIVAL_WINDOW_DAYS=30

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
INTERNAL_NOTIFICATION_EMAILS=noreply@backthred.com

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=

VITE_APP_NAME="${APP_NAME}"
