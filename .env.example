APP_NAME=Backthred
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=backthred
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

STOREFRONT_URL=http://localhost:4321
STOREFRONT_SESSION_COOKIE=storefront_session
STOREFRONT_SESSION_DOMAIN=null
STOREFRONT_CSRF_COOKIE=XSRF-STOREFRONT-TOKEN
STOREFRONT_CSRF_HEADER=X-STOREFRONT-CSRF-TOKEN
STOREFRONT_DEFAULT_REDIRECT_PATH=/account
STOREFRONT_ORDERS_PATH=/account/orders
STOREFRONT_AUTH_ERROR_REDIRECT_PATH=/auth/login
STOREFRONT_MAGIC_LINK_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=true
CATALOG_NEW_ARRIVAL_WINDOW_DAYS=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
INTERNAL_NOTIFICATION_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=


VITE_APP_NAME="${APP_NAME}"
